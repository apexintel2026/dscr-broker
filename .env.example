# Optional. POST flattened calculator lead JSON here.
# Phase 5 is paused — leave unset. Do not enable calculator lead capture
# in production without a live webhook.
HIGHLEVEL_WEBHOOK_URL=

# Optional. Show calculator LeadCapture ("Save snapshot"). Default off.
# Set to true only when HIGHLEVEL_WEBHOOK_URL is actually configured.
NEXT_PUBLIC_CALCULATOR_LEAD_CAPTURE=

# Optional. Used to build absolute report_url in lead payloads.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. HighLevel booking widget on /book.
# Defaults to the investor strategy-call calendar if unset.
NEXT_PUBLIC_GHL_BOOKING_URL=https://api.leadconnectorhq.com/widget/bookings/investor-strategy-call-gr4odyuguyt

# Optional. HighLevel form widget on /contact and as a /book fallback.
NEXT_PUBLIC_GHL_FORM_URL=https://api.leadconnectorhq.com/widget/form/F8FDVqy3kaUeK4M4KKYZ
